# Copy to .env.deploy on server (do not commit)
# Used by deploy.sh: docker run --env-file .env.deploy

ASPNETCORE_ENVIRONMENT=Production

# Required — PostgreSQL (use host.docker.internal if DB runs on same server outside Docker)
ConnectionStrings__AppDbContextConnection=Host=host.docker.internal;Port=5466;Database=Ecommerce_Aradhna;Username=postgres;Password=YOUR_PASSWORD

# Required — min 32 characters
Jwt__Key=YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG

# Required — guest cart/wishlist cookie signing
GuestSession__SigningKey=YOUR_GUEST_SESSION_SIGNING_KEY

# Optional
Jwt__Issuer=EcommerceBackend
Jwt__Audience=EcommerceUsers
Frontend__ResetPasswordUrl=https://your-frontend.com/reset-password

# Optional — email
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=Ecommerce App

# Optional — Cloudinary
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=
